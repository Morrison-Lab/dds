# Quarto render artifacts
/_site/
/.quarto/
/_freeze/
*_files/
site_libs/

# LaTeX build artifacts, from Quarto's PDF handout render
*.aux
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc

# The intermediate LaTeX Quarto writes beside the .qmd it is rendering. It is
# absent from the list above because a successful render deletes it; it
# survives only when the render aborts, which is exactly when it is left
# untracked-and-committable next to the sources. Scoped to chapters/ rather
# than a blanket *.tex, so a hand-written .tex elsewhere stays visible.
/chapters/**/*.tex

# knitr's copy of a chapter with every include expanded, written beside the
# .qmd while its chunks run. Like the .tex above, it is deleted when the render
# finishes, so it is only ever seen mid-render or after an abort, and a
# `git add` in either moment commits a stale second copy of the chapter (#398).
/chapters/**/*.rmarkdown

# A chapter rendered on its own (`quarto render chapters/<name>.qmd`) also leaves
# its page HTML beside the source. No chapter HTML is ever source here, so
# ignore it.
# The pattern is scoped to chapters/, so a hand-written .html elsewhere stays visible.
# `*-slides.html` below is a separate rule, for the slide decks.
/chapters/**/*.html

# Rendered handouts and slide decks; the sources are the .qmd files.
*.pdf
*-slides.html

# Editor and OS metadata
.DS_Store
.Rproj.user/
.Rhistory
.vscode/

# Python bytecode from the conversion scripts
__pycache__/
*.pyc

**/*.quarto_ipynb

# Agent scratch worktrees. A subagent dispatched with worktree isolation gets
# one of these inside the checkout, and `git add -A` picks it up as a gitlink
# to a repository no clone can resolve. Ignored so that cannot happen.
#
# Scoped to worktrees/ rather than the whole of .claude/, matching ai-config's
# own line. That repository tracks .claude/agents/*.md, so a blanket ignore
# here would silently refuse the same files if this repository ever vendors an
# agent definition -- and `git add -A` skips an ignored path without saying so.
.claude/worktrees/
.claude/settings.local.json

# Header files tools/build_math_macros.py writes from the latex-macros
# submodule before every render.
/_math-macros.html
/_math-macros.tex

# Written by tools/skip-pdf-in-previews.py on a preview build.
/preview-no-pdf.txt

# Generated by tools/build_dependency_graph.py
chapters/dependency-graph.json

# Fetched at render time by tools/install-extensions.py, not vendored
/_extensions/coatless-quarto/
